{
  "name": "@platform/ui-components",
  "version": "1.0.0",
  "description": "Shared UI Components",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "types": "./dist/index.d.ts"
    },
    "./Navbar": {
      "import": "./src/components/Navbar.tsx",
      "types": "./dist/components/Navbar.d.ts"
    },
    "./Footer": {
      "import": "./src/components/Footer.tsx",
      "types": "./dist/components/Footer.d.ts"
    },
    "./style": "./src/components/NavigationBar.module.scss"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "lint": "eslint. --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "clean": "rm -rf dist.turbo"
  },
  "peerDependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.8.2",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.30.1",
    "vite": "7.1.4",
    "vite-plugin-dts": "4.5.3"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.1.2",
    "@platform/styles": "1.0.0"
  }
}
