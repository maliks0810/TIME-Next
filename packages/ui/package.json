{
  "name": "@platform/ui",
  "version": "1.0.0",
  "description": "Shared UI Components",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
      "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
