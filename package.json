{
  "name": "time-next",
  "private": true,
  "packageManager": "npm@10.8.2",
  "version": "1.0.0",
  "type": "module",
  "description": "Platform Engineering Monorepo Project",
  "scripts": {
    "new:app": "plop app",
    "dev": "turbo run dev --parallel",
    "dev:shell": "turbo run dev --filter=@platform/platform-shell",
    "build": "turbo run build",
    "build:dev": "turbo run build -- --mode dev",
    "build:prod": "turbo run build -- --mode prod",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "deps:check": "syncpack list-mismatches",
    "deps:fix": "syncpack fix-mismatches",
    "deps:update": "syncpack update",
    "deps:lint": "syncpack lint",
    "deps:format": "syncpack format",
    "deps:list": "syncpack list",
    "deps:audit": "npm run deps:check && npm run deps:lint",
    "pre-commit": "npm run deps:audit && npm run deps:fix",
    "postinstall": "npm run deps:check"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "plop": "^4.0.1",
    "sass": "^1.90.0",
    "syncpack": "^13.0.4",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "vite-plugin-sass-dts": "^1.3.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines:": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
