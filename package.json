{
  "name": "time-next",
  "private": true,
  "packageManager": "npm@10.8.2",
  "version": "1.0.0",
  "type": "module",
  "description": "Platform Engineering Monorepo Project",
  "scripts": {
    "new:app": "plop app",
    "dev": "turbo run dev --parallel",
    "prod": "turbo run prod --parallel",
    "build": "turbo run build",
    "build:sandbox": "turbo run build:sandbox",
    "build:development": "turbo run build:development",
    "build:qa": "turbo run build:qa",
    "build:production": "turbo run build:production",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:all": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:all:fix": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix",
    "type-check": "turbo run type-check",
    "deps:check": "syncpack list-mismatches",
    "deps:fix": "syncpack fix-mismatches",
    "deps:update": "syncpack update",
    "deps:lint": "syncpack lint",
    "deps:format": "syncpack format",
    "deps:list": "syncpack list",
    "deps:audit": "npm run deps:check && npm run deps:lint",
    "pre-commit": "npm run deps:audit && npm run deps:fix",
    "postinstall": "npm run deps:check"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.47.0",
    "@typescript-eslint/parser": "8.47.0",
    "eslint": "9.39.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "plop": "4.0.4",
    "sass": "1.94.2",
    "syncpack": "13.0.4",
    "turbo": "2.6.1",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "apps/*",
    "apps/features/**",
    "packages/*"
  ],
  "engines:": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  }
}
