{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./dist",
        "baseUrl": ".",
        "paths": {
          "@/*": ["./src/*"],
          "@platform/ui": ["../../packages/ui/src"],
          "@platform/styles": ["../../packages/styles/src"],
          "@platform/app-registry": ["../../packages/app-registry/src"],
          "@platform/platform-shell/*": ["./*"],
        }
    },
    "include": ["src/**/*", "vite.config.ts"],
    "exclude": ["node_modules", "dist"],
    "references": [
      { "path": "../../packages/ui" },
      { "path": "../../packages/styles" },
      { "path": "../../packages/app-registry" },
    ]
}
