# No need to put app name in front of CONTENT_MGMT or any variables.
# during the vite config build in the platform-shell, it will go through every
# applicaton and append team name after VITE_(team name)_variable and combine
# every variable.
VITE_APP_NAME=QRE
VITE_CONTENT_MGMT=https://qre-service-layer-dev.np.tcw.com/rar/qre/v1/api