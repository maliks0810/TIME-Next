    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@platform/ui": "1.0.0",
    "@platform/styles": "1.0.0",
    "@platform/utils": "1.0.0",
    "@mui/icons-material": "7.3.6",
    "@mui/material": "7.3.6",
    "@mui/x-date-pickers": "8.22.1",
    "final-form": "4.20.4",
    "react-final-form": "6.5.9"
  },
  "devDependencies": {}
}
