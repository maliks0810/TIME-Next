{
  "name": "@iod/equity-budget-commission",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Application to manage and maintain budgets and commissions for equity group",
  "scripts": {
    "build": "vite build",
    "build:sandbox": "vite build --mode sandbox",
    "build:development": "vite build --mode development",
    "build:qa": "vite build --mode qa",
    "build:production": "vite build --mode production",
    "clean": "rm -rf dist .turbo node_modules",
    "dev": "vite",
    "prod": "vite --mode production",
    "preview": "vite preview --port 3200",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@platform/styles": "1.0.0",
    "@platform/ui": "1.0.0",
    "@platform/utils": "1.0.0",
    "@testing-library/user-event": "14.6.1",
    "dayjs": "1.11.19",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/uuid": "10.0.0",
    "@vitest/coverage-v8": "4.0.16"
  }
}
