{
  "name": "@IOD/pfa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "portfolio analyzer",
  "scripts": {
    "build": "vite build",
    "build:css": "npx @tailwindcss/cli -i ./src/styles/pfa.css -o ./src/generated/pfa.css --minify",
    "build:sandbox": "vite build --mode sandbox",
    "build:development": "vite build --mode development",
    "build:qa": "vite build --mode qa",
    "build:production": "vite build --mode production",
    "clean": "rm -rf dist .turbo node_modules",
    "dev": "vite",
    "sandbox": "vite --mode sandbox",
    "prod": "vite --mode production",
    "preview": "vite preview --port ",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@platform/ui": "1.0.0",
    "@platform/styles": "1.0.0",
    "@platform/utils": "1.0.0",
    "clsx": "2.1.1",
    "lucide-react": "1.14.0",
    "tailwind-merge": "3.5.0",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.2.4",
    "@tailwindcss/vite": "4.2.4",
    "tailwindcss": "4.2.4"
  }
}
