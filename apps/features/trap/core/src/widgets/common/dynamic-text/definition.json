{
    "id": "cwd_dynamic_text",
    "name": "Dynamic Text",
    "version": 1,
    "description": "A text widget that allows to use context values",
    "tags": null,
    "category": "widgetDefinition",
    "datasetId": "ds_dynamic_text",
    "listensToKeys": null,
    "emitsKeys": [],
    "configSchema": {
        "properties": {
            "channel": {
                "default": 1,
                "description": "Widgets connected to the same channel able to share data between each other",
                "enum": [1, 2, 3, 4],
                "title": "Communication Channel",
                "type": "string",
                "category": "Interactions"
            },
            "customColor": {
                "default": "#ffffff",
                "title": "Custom Solid Background Color",
                "type": "string",
                "withColorPicker": true,
                "category": "Colors"
            },
            "customGradientEnd": {
                "default": "#60a5fa",
                "title": "Gradient Background End Color",
                "type": "string",
                "withColorPicker": true,
                "category": "Colors"
            },
            "customGradientStart": {
                "default": "#2563eb",
                "title": "Gradient Background Start Color",
                "type": "string",
                "withColorPicker": true,
                "category": "Colors"
            },
            "content": {
                "default": "",
                "title": "Content",
                "type": "string",
                "editor": true,
                "category": "View Parameters"
            },
            "opacity": {
                "title": "Widget opacity",
                "type": "number",
                "default": 100,
                "category": "View Parameters"
            },
            "schemaKey": {
                "title": "Schema key",
                "type": "string",
                "enum": ["example.calculation"],
                "category": "System Parameters"
            },
            "listensToKeys": {
                "default": null,
                "title": "Listens to key",
                "type": "string",
                "enum": ["example.input", "common.date"],

                "multiselect": true,
                "category": "Interactions"
            },
            "themeMode": {
                "default": "theme",
                "enum": ["theme", "customSolid", "customGradient"],
                "title": "Color Mode",
                "type": "string",
                "category": "Colors"
            }
        },
        "required": [],
        "type": "object"
    },
    "uiHints": {
        "category": "Common"
    },
    "variants": [
        {
            "id": "small-vertical",
            "label": "Small Vertical",
            "grid": {
                "defaultW": 1,
                "defaultH": 120,
                "minW": 1,
                "minH": 120,
                "maxW": null,
                "maxH": null
            }
        },
        {
            "id": "small-horizontal",
            "label": "Small Horizontal",
            "grid": {
                "defaultW": 2,
                "defaultH": 60,
                "minW": 2,
                "minH": 60,
                "maxW": null,
                "maxH": null
            }
        },
        {
            "id": "medium-vertical",
            "label": "Medium Vertical",
            "grid": {
                "defaultW": 2,
                "defaultH": 240,
                "minW": 2,
                "minH": 240,
                "maxW": null,
                "maxH": null
            }
        },
        {
            "id": "medium-horizontal",
            "label": "Medium Horizontal",
            "grid": {
                "defaultW": 4,
                "defaultH": 120,
                "minW": 4,
                "minH": 120,
                "maxW": null,
                "maxH": null
            }
        }
    ]
}
