{
    "id": "cwd_dynamic_text",
    "name": "Dynamic Text",
    "version": 1,
    "description": "A text widget that allows to use context values",
    "tags": null,
    "category": "widgetDefinition",
    "datasetId": "ds_dynamic_text",
    "listensToKeys": null,
    "emitsKeys": [],
    "configSchema": {
        "properties": {
            "channel": {
                "default": 1,
                "description": "Widgets connected to the same channel able to share data between each other",
                "enum": [
                    1,
                    2,
                    3,
                    4
                ],
                "title": "Communication Channel",
                "type": "string",
                "category": "Interactions"
            },
            "customColor": {
                "default": "#ffffff",
                "title": "Custom Solid Background Color",
                "type": "string",
                "withColorPicker": true,
                "category": "Colors"
            },
            "customGradientEnd": {
                "default": "#60a5fa",
                "title": "Gradient Background End Color",
                "type": "string",
                "withColorPicker": true,
                "category": "Colors"
            },
            "customGradientStart": {
                "default": "#2563eb",
                "title": "Gradient Background Start Color",
                "type": "string",
                "withColorPicker": true,
                "category": "Colors"
            },
            "content": {
                "default": "",
                "title": "Content",
                "type": "string",
                "editor": true,
                "category": "View Parameters"
            },
            "opacity": {
                "title": "Widget opacity",
                "type": "number",
                "default": 100,
                "category": "View Parameters"
            },
            "schemaKey": {
                "title": "Schema key",
                "type": "string",
                "enum": [
                    "example.calculation"
                ],
                "category": "System Parameters"
            },
            "listensToKeys": {
                "default": null,
                "title": "Listens to key",
                "type": "string",
                "enum": [
                    "example.input",
                    "common.date"
                ],
                "multiselect": true,
                "category": "Interactions"
            },
            "themeMode": {
                "default": "theme",
                "enum": [
                    "theme",
                    "customSolid",
                    "customGradient"
                ],
                "title": "Color Mode",
                "type": "string",
                "category": "Colors"
            }
        },
        "required": [],
        "type": "object"
    },
    "uiHints": {
        "category": "Common"
    },
    "variants": [
        {
            "id": "default",
            "label": "Default",
            "sizing": {
                "resizable": true,
                "width": {
                    "default": 1,
                    "min": 1,
                    "max": 12
                },
                "height": {
                    "default": 120,
                    "min": 60,
                    "max": 240,
                    "step": 10
                }
            }
        }
    ]
}
