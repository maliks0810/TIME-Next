{
    "id": "cwd_common_counter_tile_01",
    "name": "KPI Tile",
    "version": 1,
    "description": "Reusable KPI tile widget. GraphQL resolves the requested KPI scenario and returns a numeric result with optional display metadata.",
    "tags": null,
    "category": "widgetDefinition",
    "datasetId": "ds_common_counter_tile_01",
    "listensToKeys": ["portfolio.id", "security.ticker", "security.cusip"],
    "emitsKeys": null,
    "configSchema": {
        "properties": {
            "channel": {
                "category": "Interactions",
                "default": 1,
                "description": "Widgets connected to the same channel able to share data between each other",
                "enum": [1, 2, 3, 4, 5],
                "title": "Communication Channel",
                "type": "string"
            },
            "clickable": {
                "category": "Interactions",
                "default": true,
                "title": "Tile is clickable",
                "type": "boolean"
            },
            "customColor": {
                "category": "Colors",
                "default": "#ffffff",
                "title": "Custom Solid Color",
                "type": "string",
                "withColorPicker": true
            },
            "customGradientEnd": {
                "category": "Colors",
                "default": "#60a5fa",
                "title": "Gradient End Color",
                "type": "string",
                "withColorPicker": true
            },
            "customGradientStart": {
                "category": "Colors",
                "default": "#2563eb",
                "title": "Gradient Start Color",
                "type": "string",
                "withColorPicker": true
            },
            "emptyStateText": {
                "category": "View Parameters",
                "default": "No value",
                "title": "Empty State Text",
                "type": "string"
            },
            "filter": {
                "category": "System Parameters",
                "description": "Which value the selected Schema Key should resolve. Valid options are scoped to the chosen Schema Key (arc.status.query -> ARC status values; econ.indicators.heatmap -> indicator metrics).",
                "enum": [
                    "ANALYTICS REQUESTED",
                    "ANALYTICS INPUT PENDING REVIEW",
                    "ANALYTICS INPUT SENT TO ALADDIN",
                    "ANALYTICS INPUT VERIFIED IN ALADDIN",
                    "ANALYTICS CALCULATION IN PROGRESS",
                    "ANALYTICS PENDING REVIEW",
                    "ANALYTICS SENT TO ALADDIN",
                    "ANALYTICS VERIFIED IN ALADDIN",
                    "MANUAL",
                    "ABANDONED",
                    "INVALID REQUEST",
                    "TOTAL",
                    "Total Indicators",
                    "Latest Period",
                    "Improving Count",
                    "Deteriorating Count"
                ],
                "options": [
                    {
                        "condition": {
                            "key": "schemaKey",
                            "value": "arc.status.query"
                        },
                        "options": [
                            "ANALYTICS REQUESTED",
                            "ANALYTICS INPUT PENDING REVIEW",
                            "ANALYTICS INPUT SENT TO ALADDIN",
                            "ANALYTICS INPUT VERIFIED IN ALADDIN",
                            "ANALYTICS CALCULATION IN PROGRESS",
                            "ANALYTICS PENDING REVIEW",
                            "ANALYTICS SENT TO ALADDIN",
                            "ANALYTICS VERIFIED IN ALADDIN",
                            "MANUAL",
                            "ABANDONED",
                            "INVALID REQUEST",
                            "TOTAL"
                        ]
                    },
                    {
                        "condition": {
                            "key": "schemaKey",
                            "value": "econ.indicators.heatmap"
                        },
                        "options": [
                            "Total Indicators",
                            "Latest Period",
                            "Improving Count",
                            "Deteriorating Count"
                        ]
                    }
                ],
                "title": "Filter",
                "type": "string"
            },
            "numberFormat": {
                "category": "View Parameters",
                "default": "integer",
                "enum": ["integer", "decimal", "currency", "percent"],
                "title": "Number Format",
                "type": "string"
            },
            "prefixText": {
                "category": "View Parameters",
                "default": "",
                "title": "Prefix Text",
                "type": "string"
            },
            "schemaKey": {
                "category": "System Parameters",
                "description": "Logical KPI scenario resolved by GraphQL. Each scenario owns its own set of valid Filter values.",
                "enum": ["arc.status.query", "econ.indicators.heatmap"],
                "title": "Schema Key",
                "type": "string"
            },
            "suffixText": {
                "category": "View Parameters",
                "default": "",
                "title": "Suffix Text",
                "type": "string"
            },
            "textColor": {
                "category": "Colors",
                "default": "#000000",
                "title": "Custom Text Color",
                "type": "string",
                "withColorPicker": true
            },
            "themeMode": {
                "category": "Colors",
                "default": "theme",
                "enum": ["theme", "customSolid", "customGradient"],
                "title": "Color Mode",
                "type": "string"
            },
            "titlePosition": {
                "category": "View Parameters",
                "default": "top",
                "enum": ["top", "bottom"],
                "title": "Title Position",
                "type": "string"
            },
            "titleText": {
                "category": "View Parameters",
                "default": "",
                "title": "Custom Title Text",
                "type": "string"
            }
        },
        "required": ["schemaKey", "filter"],
        "type": "object"
    },
    "uiHints": {
        "category": "Common",
        "visibleIn": ["workflow", "landing"]
    },
    "variants": [
        {
            "id": "default",
            "label": "Default",
            "sizing": {
                "resizable": true,
                "width": {
                    "default": 3,
                    "min": 1,
                    "max": 6,
                    "step": null
                },
                "height": {
                    "default": 100,
                    "min": 100,
                    "max": 200,
                    "step": 50
                }
            }
        }
    ]
}
