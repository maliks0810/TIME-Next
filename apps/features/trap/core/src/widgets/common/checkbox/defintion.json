{
    "id": "cwd_checkbox",
    "name": "Checkbox",
    "version": 1,
    "description": "A checkbox control widget",
    "tags": null,
    "category": "widgetDefinition",
    "datasetId": "ds_checkbox",
    "listensToKeys": null,
    "emitsKeys": [],
    "configSchema": {
        "properties": {
            "channel": {
                "default": 1,
                "description": "Widgets connected to the same channel able to share data between each other",
                "enum": [
                    1,
                    2,
                    3,
                    4
                ],
                "title": "Communication Channel",
                "type": "string"
            },
            "layout": {
                "title": "Layout variant",
                "description": "Choose checkbox layout option",
                "type": "string",
                "enum": [
                    "vertical",
                    "horizontal"
                ]
            },
            "label": {
                "title": "Checkbox label",
                "type": "string",
                "default": ""
            },
            "value": {
                "title": "Checkbox key",
                "type": "string",
                "default": ""
            },
            "checked": {
                "title": "Is checked by default",
                "type": "boolean",
                "default": false
            }
        },
        "required": [
            "value",
            "label"
        ],
        "type": "object"
    },
    "uiHints": {
        "category": "Common"
    },
    "variants": [
        {
            "id": "default",
            "label": "Default",
            "sizing": {
                "resizable": true,
                "width": {
                    "default": 2,
                    "min": 1,
                    "max": 12
                },
                "height": {
                    "default": 45,
                    "min": 20,
                    "max": 80,
                    "step": 10
                }
            }
        }
    ]
}
