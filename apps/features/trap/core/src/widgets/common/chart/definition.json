{
    "id": "cwd_common_chart_01",
    "name": "Chart",
    "version": 1,
    "description": "Shows data as a chart.",
    "tags": null,
    "category": "widgetDefinition",
    "datasetId": "ds_common_chart_01",
    "listensToKeys": ["deal.name", "security.cusip", "security.ticker", "portfolio.id"],
    "emitsKeys": null,
    "configSchema": {
        "properties": {
            "channel": {
                "category": "Interactions",
                "default": 1,
                "description": "Widgets connected to the same channel share data (e.g. the selected deal or portfolio) between each other.",
                "enum": [1, 2, 3, 4, 5],
                "title": "Communication Channel",
                "type": "string"
            },
            "emptyStateText": {
                "category": "View Parameters",
                "default": "No chart data",
                "description": "Message shown when the scenario returns no chart (e.g. nothing selected on the channel yet).",
                "title": "Empty State Text",
                "type": "string"
            },
            "schemaKey": {
                "category": "System Parameters",
                "description": "Logical chart scenario resolved by GraphQL. Each scenario owns its own series and data source; GraphQL returns the render-ready ECharts option.",
                "enum": ["abf.performance.summary", "abf.cgl.trend"],
                "title": "Schema Key",
                "type": "string"
            },
            "showTitle": {
                "category": "View Parameters",
                "default": true,
                "description": "Show the chart's title row (icon + label) above the plot.",
                "title": "Show Title",
                "type": "boolean"
            },
            "titleText": {
                "category": "View Parameters",
                "default": "",
                "description": "Overrides the chart title. Leave blank to use the scenario title from GraphQL.",
                "title": "Custom Title Text",
                "type": "string"
            }
        },
        "required": ["schemaKey"],
        "type": "object"
    },
    "uiHints": {
        "category": "Common",
        "visibleIn": ["workflow", "landing"]
    },
    "variants": [
        {
            "id": "default",
            "label": "Default",
            "sizing": {
                "resizable": true,
                "width": {
                    "default": 4,
                    "min": 3,
                    "max": 8,
                    "step": null
                },
                "height": {
                    "default": 150,
                    "min": 100,
                    "max": 400,
                    "step": 50
                }
            }
        }
    ]
}
