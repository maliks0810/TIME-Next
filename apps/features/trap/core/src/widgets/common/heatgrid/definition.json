{
    "id": "cwd_heatmap",
    "name": "Heatmap",
    "version": 1,
    "description": "Reusable heat map grid widget for domain driven tabular data with color-coded cells.",
    "tags": null,
    "category": "widgetDefinition",
    "datasetId": "ds_heatmap",
    "listensToKeys": null,
    "emitsKeys": null,
    "configSchema": {
        "properties": {
            "channel": {
                "category": "Interactions",
                "default": 1,
                "description": "Widgets connected to the same channel are able to share data between each other",
                "enum": [1, 2, 3, 4],
                "title": "Communication Channel",
                "type": "string"
            },
            "listensToKeys": {
                "category": "Interactions",
                "enum": ["asOfDate", "schemaKey", "common.tree.item"],
                "multiselect": true,
                "title": "Listens to keys",
                "type": "string"
            },
            "schemaKey": {
                "category": "System Parameters",
                "default": "econ.indicators.heatmap",
                "description": "Logical heatmap schema resolved by GraphQL",
                "enum": ["econ.indicators.heatmap"],
                "title": "Schema Key",
                "type": "string"
            },
            "settingsView": {
                "category": "View Parameters",
                "default": "drawer",
                "enum": ["drawer", "modal"],
                "title": "Settings Panel View",
                "type": "string"
            },
            "showCollapse": {
                "category": "View Parameters",
                "default": true,
                "title": "Close every group",
                "type": "boolean"
            },
            "showExpand": {
                "category": "View Parameters",
                "default": true,
                "title": "Open every group",
                "type": "boolean"
            },
            "showExport": {
                "category": "View Parameters",
                "default": true,
                "title": "Excel download button",
                "type": "boolean"
            },
            "showGrouping": {
                "category": "View Parameters",
                "default": true,
                "title": "Breadcrumb of active row groups",
                "type": "boolean"
            },
            "showLegend": {
                "category": "View Parameters",
                "default": true,
                "title": "Color legend",
                "type": "boolean"
            },
            "showTitle": {
                "category": "View Parameters",
                "default": true,
                "title": "Widget name in the header",
                "type": "boolean"
            },
            "showTooltip": {
                "category": "View Parameters",
                "default": true,
                "title": "Hover a cell for detail",
                "type": "boolean"
            },
            "title": {
                "category": "View Parameters",
                "default": "",
                "title": "Title",
                "type": "string"
            }
        },
        "required": ["schemaKey"],
        "type": "object"
    },
    "uiHints": {
        "category": "Common",
        "library": "Custom",
        "visibleIn": ["workflow", "landing"]
    },
    "variants": [
        {
            "id": "default",
            "label": "Default",
            "sizing": {
                "resizable": true,
                "width": {
                    "default": 6,
                    "min": 1,
                    "max": 12,
                    "step": null
                },
                "height": {
                    "default": 350,
                    "min": 350,
                    "max": 1000,
                    "step": 50
                }
            }
        }
    ]
}
