{
    "id": "cwd_heatmap",
    "name": "Heatmap",
    "version": 1,
    "description": "Reusable heat map grid widget for domain driven tabular data with color-coded cells.",
    "tags": null,
    "category": "widgetDefinition",
    "datasetId": "ds_heatmap",
    "listensToKeys": null,
    "emitsKeys": null,
    "configSchema": {
        "properties": {
            "schemaKey": {
                "description": "Logical heatmap schema resolved by GraphQL",
                "enum": ["econ.indicators.heatmap"],
                "default": "econ.indicators.heatmap",
                "title": "Schema Key",
                "type": "string",
                "category": "System Parameters"
            },
            "title": {
                "default": "",
                "title": "Title",
                "type": "string",
                "category": "View Parameters"
            },
            "showTitle": {
                "default": true,
                "title": "Widget name in the header",
                "type": "boolean",
                "category": "View Parameters"
            },
            "showGrouping": {
                "default": true,
                "title": "Breadcrumb of active row groups",
                "type": "boolean",
                "category": "View Parameters"
            },
            "showLegend": {
                "default": true,
                "title": "Color legend",
                "type": "boolean",
                "category": "View Parameters"
            },
            "showTooltip": {
                "default": true,
                "title": "Hover a cell for detail",
                "type": "boolean",
                "category": "View Parameters"
            },
            "showExport": {
                "default": true,
                "title": "Excel download button",
                "type": "boolean",
                "category": "View Parameters"
            },
            "showExpand": {
                "default": true,
                "title": "Open every group",
                "type": "boolean",
                "category": "View Parameters"
            },
            "showCollapse": {
                "default": true,
                "title": "Close every group",
                "type": "boolean",
                "category": "View Parameters"
            },
            "settingsView": {
                "default": "drawer",
                "enum": ["drawer", "modal"],
                "title": "Settings Panel View",
                "type": "string",
                "category": "View Parameters"
            },
            "channel": {
                "default": 1,
                "description": "Widgets connected to the same channel are able to share data between each other",
                "enum": [1, 2, 3, 4],
                "title": "Communication Channel",
                "type": "string",
                "category": "Interactions"
            },
            "listensToKeys": {
                "enum": ["asOfDate", "schemaKey", "common.tree.item"],
                "title": "Listens to keys",
                "multiselect": true,
                "type": "string",
                "category": "Interactions"
            }
        },
        "required": ["schemaKey"],
        "type": "object"
    },
    "uiHints": {
        "category": "Common",
        "library": "Custom",
        "visibleIn": ["workflow", "landing"]
    },
    "variants": [
        {
            "id": "medium",
            "label": "Medium",
            "grid": {
                "defaultW": 6,
                "defaultH": 360,
                "minW": 4,
                "minH": 280,
                "maxW": 8,
                "maxH": 520
            }
        },
        {
            "id": "large",
            "label": "Large",
            "grid": {
                "defaultW": 10,
                "defaultH": 900,
                "minW": 8,
                "minH": 320,
                "maxW": 12,
                "maxH": 1200
            }
        },
        {
            "id": "full-width",
            "label": "Full Width",
            "grid": {
                "defaultW": 12,
                "defaultH": 1000,
                "minW": 12,
                "minH": 320,
                "maxW": 12,
                "maxH": 1200
            }
        }
    ]
}
