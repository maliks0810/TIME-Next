{
    "id": "cwd_button",
    "name": "Button",
    "version": 1,
    "description": "A button widget",
    "tags": null,
    "category": "widgetDefinition",
    "datasetId": "ds_button",
    "listensToKeys": null,
    "emitsKeys": [],
    "configSchema": {
        "properties": {
            "channel": {
                "default": 1,
                "description": "Widgets connected to the same channel able to share data between each other",
                "enum": [1, 2, 3, 4],
                "title": "Communication Channel",
                "type": "string",
                "category": "Interactions"
            },

            "label": {
                "title": "Checkbox label",
                "type": "string",
                "default": "",
                "category": "View Parameters"
            },
            "emitsKeys": {
                "title": "Emits Keys",
                "type": "string",
                "enum": ["schemaKey"],
                "category": "Interactions"
            },
            "emitValue": {
                "title": "Emits Value",
                "type": "string",
                "enum": ["portfolio.summary"],
                "category": "Interactions"
            },
            "type": {
                "title": "Type",
                "enum": ["primary", "default", "dashed", "link", "text"],
                "default": "default",
                "type": "string",
                "category": "System Parameters"
            },
            "buttonAction": {
                "title": "Button Action",
                "enum": ["emitKey", "export", "redirect"],
                "type": "string",
                "category": "Interactions"
            }
        },
        "required": ["label"],
        "type": "object"
    },
    "uiHints": {
        "category": "Common"
    },
    "variants": [
        {
            "id": "small",
            "label": "Small",
            "grid": {
                "defaultW": 1,
                "defaultH": 60,
                "minW": 1,
                "minH": 60,
                "maxW": null,
                "maxH": null
            }
        }
    ]
}
