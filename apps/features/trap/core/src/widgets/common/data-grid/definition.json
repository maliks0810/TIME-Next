{
    "id": "cwd_common_data_grid_01",
    "name": "Common Data Grid",
    "version": 1,
    "description": "Reusable DevExtreme-based data grid widget for domain driven tabular data.",
    "tags": null,
    "category": "widgetDefinition",
    "datasetId": "ds_common_data_grid_01",
    "listensToKeys": null,
    "emitsKeys": null,
    "configSchema": {
        "properties": {
            "defaultGroups": {
                "default": "",
                "description": "Comma separated column groups",
                "title": "Default groups",
                "type": "string"
            },
            "pageSize": {
                "default": 50,
                "title": "Page Size",
                "type": "number"
            },
            "rowKeyField": {
                "default": "id",
                "title": "Row Key Field",
                "type": "string"
            },
            "schemaKey": {
                "description": "Logical grid schema resolved by GraphQL",
                "enum": [
                    "portfolio.summary",
                    "prism.equity.analyst.buy.list",
                    "prism.equity.analyst.drop.list",
                    "prism.equity.analyst.coverage.list",
                    "arc.risk.status.grid",
                    "portfolio.gross.history",
                    "portfolio.benchmark.history",
                    "portfolio.net.history"
                ],
                "title": "Schema Key",
                "type": "string"
            },
            "selectionMode": {
                "default": "single",
                "enum": ["none", "single", "multiple"],
                "title": "Selection Mode",
                "type": "string"
            },
            "listensToKeys": {
                "enum": ["asOfDate", "common.data.grid.row"],
                "title": "Listens to keys",
                "type": "string"
            }
        },
        "required": ["schemaKey"],
        "type": "object"
    },
    "uiHints": {
        "category": "Common",
        "library": "DevExtreme",
        "visibleIn": ["workflow", "landing"]
    },
    "variants": [
        {
            "id": "medium",
            "label": "Medium",
            "grid": {
                "defaultW": 6,
                "defaultH": 360,
                "minW": 4,
                "minH": 280,
                "maxW": 8,
                "maxH": 520
            }
        },
        {
            "id": "large",
            "label": "Large",
            "grid": {
                "defaultW": 10,
                "defaultH": 900,
                "minW": 8,
                "minH": 320,
                "maxW": 12,
                "maxH": 1200
            }
        },
        {
            "id": "full-width",
            "label": "Full Width",
            "grid": {
                "defaultW": 12,
                "defaultH": 1000,
                "minW": 12,
                "minH": 320,
                "maxW": 12,
                "maxH": 1200
            }
        }
    ]
}
