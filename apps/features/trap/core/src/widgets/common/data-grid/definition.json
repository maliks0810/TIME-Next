{
    "id": "cwd_common_data_grid_01",
    "name": "Data Grid",
    "version": 1,
    "description": "Reusable data grid widget for large datasets.",
    "tags": null,
    "category": "widgetDefinition",
    "datasetId": "ds_common_data_grid_01",
    "listensToKeys": null,
    "emitsKeys": null,
    "configSchema": {
        "properties": {
            "defaultGroups": {
                "default": "",
                "description": "Comma separated column groups",
                "title": "Default groups",
                "type": "string",
                "category": "View Parameters"
            },
            "pageSize": {
                "default": 50,
                "title": "Page Size",
                "type": "number",
                "category": "View Parameters"
            },
            "rowKeyField": {
                "default": "id",
                "title": "Row Key Field",
                "type": "string",
                "category": "Interactions"
            },
            "schemaKey": {
                "description": "Logical grid schema resolved by GraphQL",
                "enum": [
                    "portfolio.summary",
                    "prism.equity.analyst.buy.list",
                    "prism.equity.analyst.drop.list",
                    "prism.equity.analyst.coverage.list",
                    "arc.risk.status.grid",
                    "portfolio.gross.history",
                    "portfolio.benchmark.history",
                    "portfolio.net.history",
                    "prism.comparables.equity",
                    "prism.comparables.debt",
                    "prism.issuer.profile",
                    "prism.issuer.capital_structure",
                    "prism.issuer.fundamentals"
                ],
                "title": "Schema Key",
                "type": "string",
                "category": "System Parameters"
            },
            "selectionMode": {
                "default": "single",
                "enum": ["none", "single", "multiple"],
                "title": "Selection Mode",
                "type": "string",
                "category": "Interactions"
            },
            "listensToKeys": {
                "enum": [
                    "asOfDate",
                    "common.data.grid.row",
                    "schemaKey",
                    "common.tree.item",
                    "company.id"
                ],
                "title": "Listens to keys",
                "multiselect": true,
                "type": "string",
                "category": "Interactions"
            }
        },
        "required": ["schemaKey"],
        "type": "object"
    },
    "uiHints": {
        "category": "Common",
        "library": "DevExtreme",
        "visibleIn": ["workflow", "landing"]
    },
    "variants": [
        {
            "id": "default",
            "label": "Default",
            "sizing": {
                "resizable": true,
                "width": {
                    "default": 6,
                    "min": 1,
                    "max": 12
                },
                "height": {
                    "default": 360,
                    "min": 360,
                    "max": 1000,
                    "step": 10
                }
            }
        }
    ]
}
